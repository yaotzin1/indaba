{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["**", "!**/dist", "!**/node_modules", "!vendor", "!.indaba", "!specs", "!docs", "!pnpm-lock.yaml"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110, "lineEnding": "lf" },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error", "noTsIgnore": "error", "noConsole": "off" },
      "style": { "noNonNullAssertion": "error", "useImportType": "error" },
      "complexity": { "noBannedTypes": "error" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
