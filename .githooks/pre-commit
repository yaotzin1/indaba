#!/bin/sh
#
# Runs the blocking gates from workflow.ai.yml before a commit is created.
#
# Install once per clone:  node scripts/install-hooks.mjs
#
# The document gates are pure Node and always run: they are fast, need nothing installed, and they
# are what keeps the instruction set from drifting apart and from claiming what nothing enforces.
# The toolchain gate is `pnpm qa`, run directly on the host (Windows, macOS or Linux). Without
# `node_modules` it fails and says how to install; it is never skipped silently. CI enforces every
# gate unconditionally as well.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
RESET='\033[0m'

fail() {
    printf "%b\n" "${RED}pre-commit: $1${RESET}"
    printf "%b\n" "${RED}Commit refused. Fix it, or use --no-verify only if you can say why.${RESET}"
    exit 1
}

pass() { printf "%b\n" "${GREEN}  ok${RESET}  $1"; }

printf "%s\n" "pre-commit: blocking gates from workflow.ai.yml"

# --- Always: the instruction set must stay consistent -------------------------------------
node scripts/validate-skills.mjs >/dev/null 2>&1 \
    || fail "skill validation failed -- run: node scripts/validate-skills.mjs"
pass "skills valid"

node scripts/sync-claude-skills.mjs --check >/dev/null 2>&1 \
    || fail ".claude/skills is stale -- run: node scripts/sync-claude-skills.mjs"
pass "claude skill pointers in sync"

node scripts/sync-agent-docs.mjs --check >/dev/null 2>&1 \
    || fail "AGENTS.md or GEMINI.md is stale -- run: node scripts/sync-agent-docs.mjs"
pass "agent docs in sync"

node scripts/check-workflow.mjs >/dev/null 2>&1 \
    || fail "workflow.ai.yml claims something the repository does not do -- run: node scripts/check-workflow.mjs"
pass "workflow claims match the repository"

node scripts/security-audit.mjs --source >/dev/null 2>&1 \
    || fail "security audit found exploit-prone code -- run: node scripts/security-audit.mjs"
pass "security audit"

node --test scripts/*.test.mjs >/dev/null 2>&1 \
    || fail "script self-tests failed -- run: node --test scripts/*.test.mjs"
pass "script self-tests"

# --- The toolchain gate: Biome, tsc strict and Vitest, through one command ------------------
# `pnpm qa` runs natively on any OS. It needs `pnpm install` to have run, and a hook that skipped
# the gate quietly would let an unchecked commit through, so a missing toolchain is a failure.
command -v pnpm >/dev/null 2>&1 \
    || fail "pnpm is not installed -- install Node 22 and pnpm 9 (corepack enable), then run: pnpm install"
[ -d node_modules ] \
    || fail "node_modules is missing, so the quality gate cannot run -- run: pnpm install"

printf "%s\n" "  ..  quality gate (biome, tsc strict, vitest)"
pnpm qa >/dev/null 2>&1 \
    || fail "quality gate failed -- run: pnpm qa"
pass "quality gate (pnpm qa)"

printf "%b\n" "${GREEN}pre-commit: gates passed${RESET}"
printf "%s\n" "The dependency audit, the packed-install smoke test and the Windows and macOS runs happen in CI."
