{
  "name": "indaba",
  "version": "0.1.0-alpha.2",
  "description": "Deterministic orchestration, debate and observability engine for multi-agent AI workflows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaotzin1/indaba.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/yaotzin1/indaba/issues"
  },
  "homepage": "https://github.com/yaotzin1/indaba#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "bin": {
    "indaba": "./dist/bin.js"
  },
  "dependencies": {
    "@indaba/core": "workspace:*",
    "@indaba/engine": "workspace:*",
    "@indaba/runners": "workspace:*"
  }
}
