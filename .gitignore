# Indaba's own runtime state
/.indaba/worktrees/
/.indaba/traces/
/.indaba/artifacts/

# Secrets: only .env.example may be committed (scripts/security-audit.mjs fails on a present .env)
/.env
/.env.*
!/.env.example

# Node
node_modules/
/packages/*/dist/
# The page staged into @indaba/server while it is packed (scripts/stage-page.mjs)
/packages/server/page/
*.tsbuildinfo
.stryker/
coverage/
coverage-tmp/
