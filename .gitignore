# Indaba's own runtime state: worktrees, traces, artifacts, logs, run copies, discussions (AGENTS.md, section 2)
/.indaba/

# Secrets: only .env.example may be committed (scripts/security-audit.mjs fails on a present .env)
/.env
/.env.*
!/.env.example

# Node
node_modules/
/packages/*/dist/
# The page staged into @indaba/server while it is packed (scripts/stage-page.mjs)
/packages/server/page/
*.tsbuildinfo
.stryker/
coverage/
coverage-tmp/
