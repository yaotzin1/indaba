#!/usr/bin/env php
<?php

declare(strict_types=1);

use Indaba\Console\PlanCommand;
use Indaba\Console\RunCommand;
use Indaba\Console\ValidateCommand;
use Symfony\Component\Console\Application;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

$app = new Application('Indaba', '0.1.0');
$app->addCommands([new ValidateCommand(), new PlanCommand(), new RunCommand()]);
$app->run();
